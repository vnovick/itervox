#!/bin/sh
# A new version whose deploy asks a question with no newline and reads the
# answer from stdin. Nothing ever writes to that stdin and it never ends,
# so it waits: the idle window must see it and kill its group, including
# the child it started (whose pid goes to hang.pid in the working dir).
case "$1" in
--version) echo "fake 1.2.0" ;;
deploy)
	sleep 60 >/dev/null 2>&1 &
	echo $! >"$PWD/hang.pid"
	echo "Usage: fake deploy [--prod]"
	echo "Deploys the current directory."
	echo "Built 2026-01-02T03:04:05Z in 12ms"
	echo "config: $HOME/.config/fake.json, cwd: $PWD" >&2
	printf 'Deploy to production? '
	read -r answer
	echo "answer: $answer"
	;;
env) env | sort ;;
*) echo "fake: unknown command $1" >&2; exit 2 ;;
esac
