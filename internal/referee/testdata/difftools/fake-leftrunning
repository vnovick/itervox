#!/bin/sh
# A new version whose deploy prints what fake-1.0.0 prints and exits 0, but
# leaves a process running that holds its output (a background upload, a
# watcher). Its pid goes to hang.pid in the working directory.
case "$1" in
--version) echo "fake 1.0.0" ;;
deploy)
	echo "Usage: fake deploy [--prod]"
	echo "Deploys the current directory."
	echo "Built 2026-01-02T03:04:05Z in 12ms"
	echo "config: $HOME/.config/fake.json, cwd: $PWD" >&2
	(sleep 20) &
	echo $! >"$PWD/hang.pid"
	;;
env) env | sort ;;
*) echo "fake: unknown command $1" >&2; exit 2 ;;
esac
