---
// itervox.dev landing page (Liquid Glass). Sections live in
// src/components/landing/; tokens and glass surfaces in src/styles/glass.css,
// shared with the Starlight docs.
import '../styles/glass.css';
import '../styles/landing.css';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Features from '../components/landing/Features.astro';
import Showcase from '../components/landing/Showcase.astro';
import InControl from '../components/landing/InControl.astro';
import Backends from '../components/landing/Backends.astro';
import Desktop from '../components/landing/Desktop.astro';
import Start from '../components/landing/Start.astro';
import Footer from '../components/landing/Footer.astro';

const title = "Itervox — Your codebase's journey, narrated by agents";
const description =
  'Orchestrate AI agents across issues, profiles, and machines. Full visibility from dispatch to PR.';
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#080c17" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itervox.dev" />
    <meta property="og:image" content="https://itervox.dev/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://itervox.dev/og-image.svg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Same key and values as Starlight's theme picker, so the landing page
      // and the docs always open in the same theme.
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        const theme = stored === 'light' || stored === 'dark' ? stored : prefersLight ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="glow-field" aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <Hero />
      <HowItWorks />
      <Features />
      <Showcase />
      <InControl />
      <Backends />
      <Desktop />
      <Start />
    </main>
    <Footer />
  </body>
</html>
