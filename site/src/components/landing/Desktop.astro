---
import Mark from './Mark.astro';
import Shot from './Shot.astro';

const platforms = ['macOS menu bar', 'Linux tray · AppImage, .deb', 'Windows tray · MSI', 'Updates itself'];
const tray = [
  { color: '#22c55e', name: 'acme/backend', state: '3 running', active: true },
  { color: '#fb923c', name: 'acme/web', state: 'needs input' },
  { color: '#94a3b8', name: 'acme/docs', state: 'stopped' },
];
---
<section id="desktop" class="wrap section">
  <div class="glass desktop">
    <div class="copy">
      <span class="num">06 — DESKTOP APP</span>
      <h2 class="h2 desktop-title">Your fleet, one click from the menu bar</h2>
      <p class="lead">Lists every project's daemon, starts, stops and restarts them, tells you when an agent needs input or a run fails, and opens each dashboard in its own window. No terminal needed: the daemon ships inside the app.</p>
      <div class="chips">{platforms.map((p) => <span class="pill">{p}</span>)}</div>
      <div class="glass-chip cask"><span aria-hidden="true">$</span><code>brew install --cask vnovick/tap/itervox-app</code></div>
      <div><a class="btn btn-glass" href="/guides/desktop-app/">Desktop app guide</a></div>
    </div>
    <div class="visual">
      <div class="glass-card app-window">
        <div class="window-bar" aria-hidden="true">
          <span class="dot" style="background:#ff5f57"></span><span class="dot" style="background:#febc2e"></span><span class="dot" style="background:#28c840"></span>
          <span>acme/backend — Itervox</span>
        </div>
        <Shot name="desktop-app" alt="The issue view in a desktop app window, with Board, Sessions and New task in its bar" sizes="(max-width: 820px) 100vw, 560px" />
      </div>
      <div class="glass tray" role="img" aria-label="Illustration of the Itervox tray menu: three projects and the New Task, Sessions and Check for Updates items">
        <div class="tray-head"><Mark size={24} /><strong>Itervox</strong><span class="illus">Illustration</span></div>
        <div class="tray-sep"></div>
        {tray.map((t) => (
          <div class:list={['tray-row', { active: t.active }]}><span class="dot" style={`background:${t.color}`}></span><span>{t.name}</span><span class="tray-state">{t.state}</span></div>
        ))}
        <div class="tray-sep"></div>
        <div class="tray-item">New Task…</div>
        <div class="tray-item">Sessions</div>
        <div class="tray-item">Check for Updates…</div>
      </div>
    </div>
  </div>
</section>

<style>
  .desktop {
    padding: 56px;
    border-radius: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }
  .copy {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .desktop-title {
    font-size: clamp(30px, 3.8vw, 52px);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cask {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-radius: 16px;
    max-width: 100%;
    color: var(--muted);
  }
  .cask code {
    color: var(--text);
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .visual {
    flex: 1.3 1 460px;
    min-width: 0;
    position: relative;
    padding-bottom: 40px;
  }
  .app-window {
    padding: 10px;
    border-radius: 22px;
  }
  .app-window .shot {
    border-radius: 14px;
  }
  .tray {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 280px;
    padding: 10px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13.5px;
    background: var(--glass-solid);
  }
  .tray-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
  }
  .illus {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px dashed var(--hairline);
    border-radius: 999px;
    padding: 2px 8px;
  }
  .tray-sep {
    height: 1px;
    margin: 4px 6px;
    background: var(--hairline);
  }
  .tray-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
  }
  .tray-row.active {
    background: var(--accent-soft);
  }
  .tray-state {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
  }
  .tray-item {
    padding: 7px 10px;
  }
  @media (max-width: 820px) {
    .desktop {
      padding: 22px;
      border-radius: 28px;
      gap: 28px;
    }
    .visual {
      padding-bottom: 0;
    }
    .app-window {
      display: none;
    }
    .tray {
      position: static;
      width: 100%;
    }
  }
</style>
