---
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#how', label: 'How it works' },
  { href: '#features', label: 'Features' },
  { href: '#backends', label: 'Backends' },
  { href: '#desktop', label: 'Desktop app' },
  { href: '/getting-started/', label: 'Docs' },
];
---
<header class="wrap nav-wrap">
  <nav class="glass nav" aria-label="Main">
    <a class="brand" href="/" aria-label="itervox home">
      <Mark size={34} />
      <span class="wordmark">itervox</span>
    </a>
    <div class="nav-links hide-sm">
      {links.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
    </div>
    <div class="nav-actions">
      <ThemeToggle />
      <a class="btn btn-glass hide-sm" href="https://github.com/vnovick/itervox">GitHub</a>
      <a class="btn btn-primary hide-sm" href="/getting-started/">Get started</a>
      <details class="menu">
        <summary class="btn btn-glass btn-icon" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
        </summary>
        <div class="glass menu-panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="https://github.com/vnovick/itervox">GitHub</a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-top: 16px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 8px 8px 14px;
    border-radius: 999px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: 12px;
    color: var(--text);
    text-decoration: none;
  }
  .wordmark {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  .nav-links {
    display: flex;
    gap: 2px;
    flex: 1;
  }
  .nav-link {
    padding: 10px 14px;
    border-radius: 999px;
    color: var(--text2);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--subtle);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 220px;
    padding: 8px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    background: var(--glass-solid);
  }
  .menu-panel a {
    padding: 12px 14px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
  }
  .menu-panel a:hover {
    background: var(--subtle);
  }
  @media (max-width: 820px) {
    .nav-wrap {
      padding-top: 12px;
    }
    .nav {
      padding: 6px 6px 6px 12px;
    }
    .wordmark {
      font-size: 19px;
    }
    .menu {
      display: block;
    }
  }
</style>
