---
// The Visor Hex mark on its dark tile (the favicon artwork), inline so it
// needs no extra request. Decorative: the wordmark next to it carries the name.
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
const id = `vh${Math.random().toString(36).slice(2, 8)}`;
---
<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false" style="display:block;flex:none">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0f2430" /><stop offset="1" stop-color="#05090d" /></linearGradient>
    <radialGradient id={`${id}-glow`} cx="0.5" cy="0.55" r="0.6"><stop offset="0" stop-color="#2dd4bf" stop-opacity=".28" /><stop offset="1" stop-color="#2dd4bf" stop-opacity="0" /></radialGradient>
    <linearGradient id={`${id}-hex`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b9cbff" /><stop offset="1" stop-color="#3b6cf0" /></linearGradient>
    <linearGradient id={`${id}-visor`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#14b8a6" /><stop offset="1" stop-color="#7ff0de" /></linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill={`url(#${id}-bg)`} />
  <rect width="64" height="64" rx="14" fill={`url(#${id}-glow)`} />
  <g transform="translate(2 2) scale(0.9375)">
    <path d="M32 6 L54.5 19 L54.5 45 L32 58 L9.5 45 L9.5 19 Z" fill="none" stroke={`url(#${id}-hex)`} stroke-width="7.5" stroke-linejoin="round" />
    <rect x="17" y="26.5" width="30" height="11" rx="5.5" fill={`url(#${id}-visor)`} />
    <circle cx="39.5" cy="32" r="2.6" fill="#ffffff" />
  </g>
</svg>
